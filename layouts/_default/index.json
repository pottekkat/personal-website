{{- $.Scratch.Add "index" slice -}}
{{- range .Site.RegularPages -}}
    {{- if and (not .Params.searchHidden) (ne .Layout `archives`) (ne .Layout `stats`) (ne .Layout `about`) (ne .Layout `blogroll`) (ne .Layout `search`) (ne .Layout `subscribe`) }}
    {{- $title := .Title -}}
    {{- if not .Title -}}
        {{- $title = .Content | plainify | htmlUnescape | truncate 60 -}}
    {{- end -}}
    {{- $.Scratch.Add "index" (dict "title" $title "content" .Plain "permalink" .Permalink "summary" .Summary "categories" .Params.categories "section" .Section) -}}
    {{- end }}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
