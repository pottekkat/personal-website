{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.framework.id": "hugo",
  "frontMatter.content.publicFolder": "static",
  "frontMatter.preview.host": "http://localhost:1314",
  "frontMatter.preview.trailingSlash": true,
  "frontMatter.website.host": "https://navendu.me",
  "frontMatter.taxonomy.alignFilename": true,
  "frontMatter.global.timezone": "",
  "frontMatter.panel.actions.disabled": [
    "createContent"
  ],
  "frontMatter.git.disableOnBranches": [
    "hugo"
  ],
  "frontMatter.data.files": [
    {
      "id": "blogroll",
      "title": "Blogroll",
      "file": "[[workspace]]/data/blogroll/blogroll.yaml",
      "fileType": "yaml",
      "singleEntry": true,
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "required": [
          "feeds"
        ],
        "properties": {
          "feeds": {
            "type": "array",
            "description": "Array of blog feed entries",
            "items": {
              "type": "object",
              "required": [
                "title",
                "xmlURL",
                "htmlURL"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "description": "The title/name of the blog"
                },
                "xmlURL": {
                  "type": "string",
                  "description": "The URL of the RSS/Atom feed",
                  "format": "uri"
                },
                "htmlURL": {
                  "type": "string",
                  "description": "The URL of the blog's homepage",
                  "format": "uri"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "frontMatter.taxonomy.customTaxonomy": [
    {
      "id": "series",
      "options": [
        "Hands-On With Apache APISIX Ingress"
      ]
    },
    {
      "id": "genre",
      "options": [
        "American",
        "Art",
        "Astronomy",
        "Autobiography",
        "Biography",
        "Brazilian",
        "British",
        "Canadian",
        "Chinese",
        "Classics",
        "Comic",
        "Contemporary",
        "Czech",
        "Economics",
        "Engineering",
        "Fable",
        "Fantasy",
        "Fiction",
        "French",
        "German",
        "History",
        "Humor",
        "Indian",
        "Italian",
        "Japanese",
        "Latin American",
        "Memoir",
        "Music",
        "Mystery",
        "Non-Fiction",
        "Philosophy",
        "Physics",
        "Poetry",
        "Polish",
        "Politics",
        "Public Policy",
        "Religion",
        "Russian",
        "Scandinavian",
        "Science",
        "Science Fiction",
        "Sociology",
        "Space",
        "Spanish",
        "Thriller",
        "Travel"
      ]
    },
    {
      "id": "places",
      "options": [
        "austria",
        "bahrain",
        "china",
        "hungary",
        "indonesia",
        "ireland",
        "malaysia",
        "maldives",
        "singapore",
        "slovakia",
        "sri-lanka",
        "taiwan",
        "united-arab-emirates",
        "united-kingdom",
        "united-states",
        "vietnam"
      ]
    }
  ],
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "Post (default)",
      "pageBundle": false,
      "filePrefix": "",
      "slugTemplate": "{{seoTitle}}",
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "single": true
        },
        {
          "title": "Slug",
          "name": "slug",
          "type": "slug",
          "default": "{{slug}}"
        },
        {
          "title": "Publishing date",
          "name": "date",
          "type": "datetime",
          "dateFormat": "yyyy-MM-dd'T'HH:mm:ssXXX",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "Draft?",
          "name": "draft",
          "type": "draft"
        },
        {
          "title": "Table of contents (ToC)",
          "name": "toc",
          "type": "fields",
          "fields": [
            {
              "title": "Show ToC?",
              "name": "show",
              "type": "boolean",
              "default": false
            },
            {
              "title": "Open ToC?",
              "name": "open",
              "type": "boolean",
              "default": false,
              "when": {
                "fieldRef": "show",
                "operator": "eq",
                "value": true
              }
            }
          ]
        },
        {
          "title": "Show related content?",
          "name": "ShowRelatedContent",
          "type": "boolean"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Summary",
          "name": "summary",
          "type": "string"
        },
        {
          "title": "Tags",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "Categories",
          "name": "categories",
          "type": "categories"
        },
        {
          "title": "Series",
          "name": "series",
          "type": "taxonomy",
          "taxonomyId": "series"
        },
        {
          "title": "Places",
          "name": "places",
          "type": "taxonomy",
          "taxonomyId": "places"
        },
        {
          "title": "Aliases",
          "name": "aliases",
          "type": "list"
        },
        {
          "title": "Cover",
          "name": "cover",
          "type": "fields",
          "fields": [
            {
              "title": "Image",
              "name": "image",
              "type": "image",
              "isPreviewImage": true
            },
            {
              "title": "Alt text",
              "name": "alt",
              "type": "string"
            },
            {
              "title": "Caption",
              "name": "caption",
              "type": "string",
              "single": true
            },
            {
              "title": "Relative?",
              "name": "relative",
              "type": "boolean",
              "default": false
            }
          ]
        }
      ]
    },
    {
      "name": "Daily",
      "pageBundle": false,
      "filePrefix": "{{date|d-M-yy}}",
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "single": true,
          "actions": [
            {
              "title": "Add log number",
              "script": "./scripts/frontmatter/daily-logs-title.js"
            }
          ]
        },
        {
          "title": "Publishing date",
          "name": "date",
          "type": "datetime",
          "dateFormat": "yyyy-MM-dd'T'HH:mm:ssXXX",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "Draft?",
          "name": "draft",
          "type": "draft",
          "default": false
        },
        {
          "title": "Summary",
          "name": "summary",
          "type": "string"
        },
        {
          "title": "Places",
          "name": "places",
          "type": "taxonomy",
          "taxonomyId": "places"
        }
      ]
    },
    {
      "name": "Newsletter",
      "pageBundle": false,
      "filePrefix": "nl",
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "single": true
        },
        {
          "title": "Publishing date",
          "name": "date",
          "type": "datetime",
          "dateFormat": "yyyy-MM-dd'T'HH:mm:ssXXX",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "Draft?",
          "name": "draft",
          "type": "draft"
        },
        {
          "title": "Show ToC?",
          "name": "ShowToc",
          "type": "boolean",
          "default": true,
          "hidden": true
        },
        {
          "title": "Open ToC?",
          "name": "TocOpen",
          "type": "boolean",
          "default": true,
          "hidden": true
        },
        {
          "title": "Summary",
          "name": "summary",
          "type": "string"
        },
        {
          "title": "Places",
          "name": "places",
          "type": "taxonomy",
          "taxonomyId": "places"
        }
      ]
    },
    {
      "name": "TILs",
      "pageBundle": false,
      "filePrefix": "{{date|d-M-yy}}",
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "single": true
        },
        {
          "title": "Publishing date",
          "name": "date",
          "type": "datetime",
          "dateFormat": "yyyy-MM-dd'T'HH:mm:ssXXX",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        }
      ]
    },
    {
      "name": "Note",
      "pageBundle": false,
      "filePrefix": "{{date|yyyyMMddHHmmss}}",
      "fields": [
        {
          "title": "Publishing date",
          "name": "date",
          "type": "datetime",
          "dateFormat": "yyyy-MM-dd'T'HH:mm:ssXXX",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "Draft?",
          "name": "draft",
          "type": "draft",
          "default": false
        },
        {
          "title": "Response (optional - for reply/like/repost/bookmark)",
          "name": "response",
          "type": "fields",
          "fields": [
            {
              "title": "Type",
              "name": "type",
              "type": "choice",
              "choices": [
                "",
                "reply",
                "like",
                "repost",
                "bookmark"
              ],
              "default": ""
            },
            {
              "title": "URL",
              "name": "url",
              "type": "string",
              "description": "URL you're responding to"
            },
            {
              "title": "Name",
              "name": "name",
              "type": "string",
              "description": "Title/name of the content"
            }
          ]
        }
      ]
    },
    {
      "name": "Book Review",
      "pageBundle": false,
      "filePrefix": "",
      "slugTemplate": "{{title}}",
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string"
        },
        {
          "title": "Publishing date",
          "name": "date",
          "type": "datetime",
          "dateFormat": "yyyy-MM-dd'T'HH:mm:ssXXX",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "Draft?",
          "name": "draft",
          "type": "draft"
        },
        {
          "title": "Summary",
          "name": "summary",
          "type": "string"
        },
        {
          "title": "Places",
          "name": "places",
          "type": "taxonomy",
          "taxonomyId": "places"
        },
        {
          "title": "Reading Status",
          "name": "status",
          "type": "choice",
          "choices": [
            "Reading",
            "Want to Read",
            "Read",
            "Paused",
            "Abandoned"
          ]
        },
        {
          "title": "Book Metadata",
          "name": "bookMeta",
          "type": "fields",
          "fields": [
            {
              "title": "Author",
              "name": "author",
              "type": "string"
            },
            {
              "title": "Year Published",
              "name": "published",
              "type": "number"
            },
            {
              "title": "ISBN",
              "name": "isbn",
              "type": "string"
            },
            {
              "title": "Publisher",
              "name": "publisher",
              "type": "string"
            },
            {
              "title": "Page Count",
              "name": "pageCount",
              "type": "number"
            },
            {
              "title": "Genre",
              "name": "genre",
              "type": "taxonomy",
              "taxonomyId": "genre"
            },
            {
              "title": "Rating (1-5)",
              "name": "rating",
              "type": "number"
            },
            {
              "title": "Book Cover",
              "name": "coverImage",
              "type": "image",
              "isPreviewImage": true
            },
            {
              "title": "Goodreads URL",
              "name": "goodreadsUrl",
              "type": "string"
            }
          ]
        }
      ]
    },
    {
      "name": "Place",
      "pageBundle": true,
      "filePrefix": "",
      "slugTemplate": "{{title}}",
      "fields": [
        {
          "title": "Country",
          "name": "title",
          "type": "string"
        },
        {
          "title": "Publishing date",
          "name": "date",
          "type": "datetime",
          "dateFormat": "yyyy-MM-dd'T'HH:mm:ssXXX",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "Country code (ISO 3166-1, like SG)",
          "name": "code",
          "type": "string"
        },
        {
          "title": "City on the map",
          "name": "city",
          "type": "string"
        },
        {
          "title": "Map centre latitude",
          "name": "lat",
          "type": "number",
          "numberOptions": {
            "isDecimal": true,
            "min": -90,
            "max": 90
          }
        },
        {
          "title": "Map centre longitude",
          "name": "lon",
          "type": "number",
          "numberOptions": {
            "isDecimal": true,
            "min": -180,
            "max": 180
          }
        },
        {
          "title": "Map width in km (default 3.2)",
          "name": "mapWidth",
          "type": "number",
          "numberOptions": {
            "isDecimal": true,
            "min": 0.5,
            "max": 20
          }
        },
        {
          "title": "Visits (YYYY-MM)",
          "name": "visits",
          "type": "list"
        },
        {
          "title": "Summary",
          "name": "summary",
          "type": "string"
        }
      ],
      "defaultFileName": "_index"
    }
  ],
  "frontMatter.content.pageFolders": [
    {
      "title": "Posts",
      "path": "[[workspace]]/content/posts",
      "previewPath": "posts",
      "contentTypes": [
        "Post (default)"
      ],
      "excludePaths": [
        "_*.*"
      ]
    },
    {
      "title": "Dailies",
      "path": "[[workspace]]/content/dailies",
      "previewPath": "dailies",
      "contentTypes": [
        "Daily"
      ],
      "excludePaths": [
        "_*.*"
      ]
    },
    {
      "title": "Newsletters",
      "path": "[[workspace]]/content/newsletters",
      "previewPath": "newsletters",
      "contentTypes": [
        "Newsletter"
      ],
      "excludePaths": [
        "_*.*"
      ]
    },
    {
      "title": "TILs",
      "path": "[[workspace]]/content/tils",
      "previewPath": "tils",
      "contentTypes": [
        "TILs"
      ],
      "excludePaths": [
        "_*.*"
      ]
    },
    {
      "title": "Book Reviews",
      "path": "[[workspace]]/content/books",
      "previewPath": "books",
      "contentTypes": [
        "Book Review"
      ],
      "excludePaths": [
        "_*.*"
      ]
    },
    {
      "title": "Notes",
      "path": "[[workspace]]/content/notes",
      "previewPath": "notes",
      "contentTypes": [
        "Note"
      ],
      "excludePaths": [
        "_*.*"
      ]
    },
    {
      "title": "Places",
      "path": "[[workspace]]/content/places",
      "previewPath": "places",
      "contentTypes": [
        "Place"
      ]
    }
  ],
  "frontMatter.content.filters": [
    "contentFolders",
    "tags",
    "categories",
    {
      "title": "Reading status",
      "name": "status"
    }
  ],
  "frontMatter.dashboard.content.card.fields.description": "summary",
  "frontMatter.custom.scripts": [
    {
      "id": "create-image-folder",
      "title": "Create image folder",
      "script": "./scripts/frontmatter/create-image-folder.js"
    },
    {
      "id": "book-metadata",
      "title": "Fetch book metadata",
      "script": "./scripts/frontmatter/book-metadata.js",
      "command": "node",
      "type": "content",
      "contentTypes": [
        "Book Review"
      ]
    },
    {
      "id": "place-map",
      "title": "Draw city map",
      "script": "./scripts/frontmatter/place-map.js",
      "command": "node",
      "type": "content",
      "contentTypes": [
        "Place"
      ]
    }
  ],
  "frontMatter.extensibility.scripts": [
    "./.frontmatter/ui/external.js"
  ],
  "frontMatter.snippets.wrapper.enabled": false,
  "frontMatter.content.snippets": {
    "Figure": {
      "description": "Figure with title, caption, and link.",
      "body": "{{< figure src=\"[[&mediaUrl]]#center\" title=\"[[&title]]\" caption=\"[[&caption]]\" link=\"[[&mediaUrl]]\" target=\"_blank\" class=\"align-center\" >}}",
      "isMediaSnippet": true
    },
    "Quote": {
      "description": "Quote with the author, link, and title.",
      "body": [
        "{{< blockquote author=\"[[&author]]\" link=\"[[&link]]\" title=\"[[&title]]\" >}}",
        "[[&selection]]",
        "{{< /blockquote >}}"
      ],
      "fields": [
        {
          "name": "author",
          "title": "Author",
          "type": "string",
          "single": true
        },
        {
          "name": "title",
          "title": "Title",
          "type": "string",
          "single": true
        },
        {
          "name": "link",
          "title": "Link",
          "type": "string",
          "single": true
        },
        {
          "name": "selection",
          "title": "Quote",
          "type": "string",
          "default": "FM_SELECTED_TEXT"
        }
      ]
    },
    "Diagram": {
      "description": "Mermaid.js diagram.",
      "body": [
        "{{< mermaid >}}",
        "[[&selection]]",
        "{{< /mermaid >}}"
      ],
      "fields": [
        {
          "name": "selection",
          "title": "Diagram",
          "type": "string",
          "default": "FM_SELECTED_TEXT"
        }
      ]
    },
    "HTML": {
      "description": "Raw HTML code.",
      "body": [
        "{{< rawhtml >}}",
        "[[&selection]]",
        "{{< /rawhtml >}}"
      ],
      "fields": [
        {
          "name": "selection",
          "title": "HTML",
          "type": "string",
          "default": "FM_SELECTED_TEXT"
        }
      ]
    },
    "Place": {
      "description": "Link to a place page with its flag.",
      "body": "{{< place \"[[&slug]]\" >}}",
      "fields": [
        {
          "name": "slug",
          "title": "Place folder (like singapore)",
          "type": "string",
          "single": true
        }
      ]
    },
    "Newsletter template": {
      "description": "Newsletter template with headings and placeholders.",
      "body": [
        "## What's Happening?",
        "",
        "## Curated Links",
        "",
        "## Hot off the Press"
      ],
      "fields": [
        {
          "name": "selection",
          "title": "HTML",
          "type": "string",
          "default": "FM_SELECTED_TEXT"
        }
      ]
    }
  },
  "frontMatter.framework.startCommand": "hugo server -D --buildFuture --port 1314"
}
